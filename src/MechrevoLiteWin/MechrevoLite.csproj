<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!--
      完整的可空性检查。此前是 annotations：代码里到处写 ? 和 !，但编译器一个 CS86xx 都不报，
      于是 WindowsIdentity.GetCurrent().User.Value 这类必然崩溃的空引用能无声通过编译。
      核心硬件层（Hardware/）、Helpers/、Gpu/ 已全部清零；少数继承自 g-helper 的
      UI 与原生互操作文件在文件头用 `#nullable disable` 显式标注为待迁移，
      让剩余债务可见且局部化。
    -->
    <Nullable>enable</Nullable>
    <UseWindowsForms>True</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPublishable>True</IsPublishable>
    <IncludeAllContentForSelfExtract>True</IncludeAllContentForSelfExtract>
    <!--
      R2：应用改为框架依赖发布（SelfContained=false，不再随包分发 .NET 运行时）。
      ReadyToRun 实测会把载荷从 34.7 MB 抬到 42.8 MB（+8 MB，只换启动速度），因此默认关闭；
      单文件同样关闭——框架依赖单文件被 NETSDK1151 否决（被引用的 Probe.exe 是自包含的），
      而安装器本来就是把整个发布目录装进 {app}。
    -->
    <PublishReadyToRun>False</PublishReadyToRun>
    <!--
      后台占用（beta21 任务 10）：常驻托盘程序的托管堆只有几十 MB，阻塞式 gen2 回收只要几毫秒，
      后台并发 GC 省下的停顿没有意义，却常驻一条线程和额外的内存；分层 PGO 的插桩阶段同理，
      多花 JIT 时间与内存换稳态性能，而这个程序的稳态几乎全在等 MQTT 推送。两项都关。
    -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>MechrevoLite.Program</StartupObject>
    <ApplicationIcon>favicon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <AssemblyName>L-Mechrevo</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
    <DebugType>embedded</DebugType>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\x64\$(Configuration)\</IntermediateOutputPath>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <AssemblyVersion>0.289.0.0</AssemblyVersion>
    <FileVersion>0.289.0.0</FileVersion>
    <Version>0.289.0-beta21</Version>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <!-- English lives in the main Strings.resx; only ship the zh-CN satellite. Also filters TaskScheduler package satellites. -->
    <SatelliteResourceLanguages>zh-CN</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="logs\**" />
    <EmbeddedResource Remove="logs\**" />
    <None Remove="logs\**" />
    <!-- Keep English (Strings.resx in the main DLL) and zh-CN only. Other g-helper satellites stay on disk but do not compile or ship. -->
    <EmbeddedResource Remove="Properties\Strings.*.resx" />
    <EmbeddedResource Include="Properties\Strings.zh-CN.resx" />
    <Compile Remove="artifacts\**" />
    <EmbeddedResource Remove="artifacts\**" />
    <None Remove="artifacts\**" />
  </ItemGroup>


  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="LICENSE.txt">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\THIRD_PARTY_NOTICES.txt" Link="THIRD_PARTY_NOTICES.txt">
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="Resources\DefaultCurve_Gaming.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\DefaultCurve_Office.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\DefaultCurve_Turbo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="favicon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\qrcode1.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\qrcode2.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--
      T31 接缝位置（唯一选项）：应用（net10.0-windows10.0.19041.0）消费 Probe（net10.0）的
      只读接缝 IEcReadTransport / IMqttTransport；反向不可行（Probe 的 net10.0 装不下 windows TFM）。
      Probe 是 Exe + IsPublishable=false，引用合法：应用入口仍由上面的 StartupObject 指定为
      MechrevoLite.Program，Probe 的 Main 不会成为本应用的入口（有测试盯着 EntryPoint）。
    -->
    <ProjectReference Include="..\Probe\Probe.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      FftSharp 曾用于 Helpers/AudioVisualizer.cs 的频谱分析。该类的 Shared 单例
      在整个代码库里没有任何订阅者（Settings.VisualiseAudio 自身也无调用者），
      属于 g-helper 的 Slash/AnimeMatrix 音频律动灯效残留，已随类一并删除。
    -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
    <PackageReference Include="System.Management" Version="10.0.10" />
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Strings.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Strings.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!--
      PawnIO 内核模块字节码。只有 AMD 的 RyzenSMU.bin 会被加载
      （Pawn/RyzenSmu.cs -> PawnIOWrapper.LoadModuleFromResource）。
      同目录下曾有 IntelMSR.bin，但代码里没有任何加载点，是纯死负载，已删除。
      加入新 .bin 前请先确认存在对应的 Load 调用，否则只会撑大单文件产物。
    -->
    <EmbeddedResource Include="Pawn\RyzenSMU.bin">
      <LogicalName>LMechrevo.RyzenSMU.bin</LogicalName>
    </EmbeddedResource>
    <!-- T2 机型身份注册表（只含身份，见 Resources\model-registry.json 的 _comment）。 -->
    <EmbeddedResource Include="Resources\model-registry.json">
      <LogicalName>LMechrevo.model-registry.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

	<Target Name="StopRunningLMechrevo" BeforeTargets="Build" Condition="'$(GITHUB_ACTIONS)'!='true'">
		<Exec Command="powershell -NoProfile -Command &quot;try { [System.Threading.EventWaitHandle]::OpenExisting('Global\LMechrevoApp-Exit').Set() } catch {}; for ($i = 0; $i -lt 50; $i++) { if (-not (Get-Process -Name 'L-Mechrevo' -ErrorAction SilentlyContinue)) { break }; Start-Sleep -Milliseconds 100 }&quot;" />
	</Target>

  <!--
    Probe.exe is a diagnostic host (keep Probe.dll). rgb.cfg lives in %AppData%.
    System.IO.Ports / Mono.Posix are LHM Linux/serial leftovers unused on this Windows build.
    WinRT (liquid-cooling BLE fallback) and LibreHardwareMonitorLib (watts; MQTT has none) stay.
  -->
  <Target Name="TrimPublishJunk" AfterTargets="Publish">
    <ItemGroup>
      <_PublishJunk Include="$(PublishDir)Probe.exe" />
      <_PublishJunk Include="$(PublishDir)Probe.pdb" />
      <_PublishJunk Include="$(PublishDir)Probe.deps.json" />
      <_PublishJunk Include="$(PublishDir)Probe.runtimeconfig.json" />
      <_PublishJunk Include="$(PublishDir)rgb.cfg" />
      <_PublishJunk Include="$(PublishDir)System.IO.Ports.dll" />
      <_PublishJunk Include="$(PublishDir)Mono.Posix.NETStandard.dll" />
      <_PublishJunk Include="$(PublishDir)libMonoPosixHelper.dll" />
      <_PublishJunk Include="$(PublishDir)MonoPosixHelper.dll" />
      <_JunkCultureName Include="ar;cs-CZ;da;de;es;fr;hu;id;it;ja;ko;lt;pl;pt-BR;pt-PT;ro;tr;uk;vi;zh-TW" />
      <_JunkCultureDll Include="@(_JunkCultureName->'$(PublishDir)%(Identity)\*.dll')" />
      <_JunkCultureDir Include="@(_JunkCultureName->'$(PublishDir)%(Identity)')" />
    </ItemGroup>
    <Delete Files="@(_PublishJunk);@(_JunkCultureDll)" TreatErrorsAsWarnings="true" />
    <RemoveDir Directories="@(_JunkCultureDir)" />
  </Target>

</Project>
