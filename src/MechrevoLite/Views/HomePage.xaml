<UserControl x:Class="MechrevoLite.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- G-Helper 风格：顶部模式按钮条（4 个等宽大按钮） -->
        <Style x:Key="ModeBtn" TargetType="Button">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="#FF2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{TemplateBinding Tag}" HorizontalAlignment="Center" FontSize="11" Foreground="#FF9A9A9A"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF3D3D3D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF32DBBE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#FF262626"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="4,0,0,12"/>
        </Style>
        <Style x:Key="MetricName" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9A9A9A"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部模式按钮条（固定） -->
        <Border Grid.Row="0" Background="#FF222222" Padding="16,10" BorderBrush="#FF333333" BorderThickness="0,0,0,1">
            <DockPanel>
                <ItemsControl ItemsSource="{Binding Modes}" DockPanel.Dock="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Tag="{Binding Description}"
                                    Command="{Binding DataContext.SwitchModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" Style="{StaticResource ModeBtn}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel VerticalAlignment="Center" Margin="20,0,0,0" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StatusText}" Foreground="#FF32DBBE" FontSize="12" HorizontalAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="供电" Style="{StaticResource MetricName}" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Snapshot.IsAC}" Foreground="White" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 内容区：垂直分区滚动（G-Helper 布局） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,16,16,8">
            <StackPanel>
                <!-- 分区 1：性能监控 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="性能监控" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CPU 温度" Style="{StaticResource MetricName}"/>
                                <TextBlock Text="{Binding Snapshot.CpuTemp, StringFormat='{}{0:F0}°C'}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="{Binding Snapshot.CpuUsage, StringFormat='负载 {0:F0}%'}" Style="{StaticResource MetricName}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="GPU 温度" Style="{StaticResource MetricName}"/>
                                <TextBlock Text="{Binding Snapshot.GpuTemp, StringFormat='{}{0:F0}°C'}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="{Binding Snapshot.GpuUsage, StringFormat='负载 {0:F0}%'}" Style="{StaticResource MetricName}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CPU 风扇" Style="{StaticResource MetricName}"/>
                                <TextBlock Text="{Binding Snapshot.CpuFanRpm, StringFormat='{}{0} rpm'}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="{Binding Snapshot.CpuFanDuty, StringFormat='占空比 {0}%'}" Style="{StaticResource MetricName}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="电池" Style="{StaticResource MetricName}"/>
                                <TextBlock Text="{Binding Snapshot.BatteryPercent, StringFormat='{}{0}%'}" Style="{StaticResource MetricValue}"/>
                                <TextBlock Text="{Binding Snapshot.BatteryCycleCount, StringFormat='循环 {0} 次'}" Style="{StaticResource MetricName}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 分区 2：电源信息 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="电源信息" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,48,0">
                                <TextBlock Text="当前配置" Style="{StaticResource MetricName}"/>
                                <TextBlock Text="{Binding Snapshot.ProfileName}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,48,0">
                                <TextBlock Text="PL1 / PL2" Style="{StaticResource MetricName}"/>
                                <TextBlock Foreground="White" FontSize="18" FontWeight="Bold">
                                    <Run Text="{Binding Snapshot.CpuPl1, StringFormat='{}{0}'}"/><Run Text=" / "/><Run Text="{Binding Snapshot.CpuPl2, StringFormat='{}{0} W'}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="TccOffset" Style="{StaticResource MetricName}"/>
                                <TextBlock Text="{Binding Snapshot.CpuTccOffset, StringFormat='{}{0}°C'}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- M3+：风扇曲线 / GPU / 灯效 / 电池 / 快捷开关 / 设置 分区依次加入 -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
