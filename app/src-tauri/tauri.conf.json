{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "L-Mechrevo",
  "version": "0.289.0-beta18",
  "identifier": "cn.lmechrevo.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "L-Mechrevo",
        "width": 420,
        "height": 529,
        "resizable": true
      },
      {
        "label": "hud",
        "title": "HUD",
        "url": "index.html?window=hud",
        "width": 320,
        "height": 96,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "transparent": true
      },
      {
        "label": "custom-mode",
        "width": 420,
        "height": 529,
        "visible": false,
        "url": "index.html?window=custom",
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
